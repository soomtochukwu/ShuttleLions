# ==========================================
# ShuttleLions UNN - Local Environment Config
# ==========================================

# ------------------------------------------
# 1. Supabase Credentials
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# 2. Nodemailer SMTP Configuration
# ------------------------------------------
# If these are left blank, ShuttleLions will run in "Local Preview Mode"
# where generated emails are logged directly to the server terminal.

# OPTION A: Mailtrap (Recommended for Local Testing)
# 1. Sign up at https://mailtrap.io (Free tier)
# 2. Go to Email Testing > Inboxes > SMTP Settings
# 3. Copy the credentials below:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# SMTP_FROM="ShuttleLions UNN" <notifications@shuttlelions.unn>

# OPTION B: Gmail (Real Delivery to Inboxes)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="ShuttleLions UNN" <your-email@gmail.com>
